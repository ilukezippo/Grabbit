    <string name="tour_share_with">Share with</string>
    <string name="tour1_title">Share a link to Grabbit</string>
    <string name="tour1_text">In YouTube, Instagram, TikTok or any app, tap Share and pick Grabbit. Or copy the link and open Grabbit.</string>
    <string name="tour2_title">Pick the quality</string>
    <string name="tour2_text">Choose 144p to 4K, MP4, MKV or WEBM, or just the sound as MP3. Grabbit remembers your choice.</string>
    <string name="tour3_title">Everything in Downloads</string>
    <string name="tour3_text">Tap a file to open it. Long-press to select several and convert, clear or delete them.</string>
    <string name="tour4_title">Record your screen</string>
    <string name="tour4_text">Tap Record in the notification or the Quick Settings tile, from any app, with sound and a countdown.</string>
    <string name="tour5_title">Make it yours</string>
    <string name="tour5_text">Download right away with your favourite quality, sign in to Instagram for stories, and keep downloads fast.</string>
